# Configuración de la demo en Docker. Copiar a .env (no se sube a git) y ajustar.

# ":80" publica por HTTP con la IP del servidor. Con un dominio que apunte a esa IP
# (por ejemplo secopedia.midominio.com), Caddy activa HTTPS automáticamente.
SECOPEDIA_DIRECCION=:80

# Puertos publicados. Con dominio y HTTPS automático deben ser 80 y 443.
PUERTO_HTTP=80
PUERTO_HTTPS=443

# Modelos que se cargan al arrancar. Vacío: se cargan al pedirlos.
SECOPEDIA_PRECARGAR=regresion_logistica,svm_lineal,red_neuronal,beto

# Límite de memoria del contenedor e hilos de cálculo (valores para 2 vCPU y 4 GB).
MEMORIA_APP=3g
HILOS=2
