# Copiar a deploy/servidor.env (no se sube a git) y completar.

# IP pública o nombre del servidor
SSH_HOST=203.0.113.10
# Usuario de Ubuntu en EC2
SSH_USUARIO=ubuntu
SSH_PUERTO=22
# Llave descargada al crear la instancia (fuera del repositorio). Permisos: chmod 400
SSH_LLAVE="$HOME/.ssh/secopedia.pem"
# Carpeta en el servidor, relativa al directorio del usuario
CARPETA_REMOTA=secopedia

# ":80" publica por HTTP con la IP. Con un dominio que apunte a la IP (por ejemplo
# secopedia.midominio.com), Caddy activa HTTPS automáticamente.
SECOPEDIA_DIRECCION=":80"
# Modelos que se cargan al arrancar. Vacío: se cargan al pedirlos.
SECOPEDIA_PRECARGAR="regresion_logistica,svm_lineal,red_neuronal,beto"
# Límite de memoria del contenedor e hilos de cálculo (valores para una t3.medium)
MEMORIA_APP=3g
HILOS=2
