# Copy to deploy/hosts.env (git-ignored) and fill in.
SSH_USER=estudiante
SSH_PORT=22
# Machine 1: LLM (llama.cpp + Qwen2.5-7B Q4, ~5.5 GB of RAM)
M1_HOST=10.0.0.1
# Machine 2: app (API + UI + BiomedBERT + corrector)
M2_HOST=10.0.0.2
# Folder on the servers
REMOTE_DIR=medec
# Public port of the UI (8000-8025 are open to the internet)
APP_PORT=8000
# LLM port: outside 8000-8025 so it is only reachable inside the network
LLM_PORT=8080
LLM_THREADS=4
LLM_CTX=8192
# "docker" or "sudo docker" if the user is not in the docker group
DOCKER="docker"
